[Unit]
Description=CloudOps Pulse Web Application (Gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aws-devops-webapp
Environment="PATH=/home/ubuntu/aws-devops-webapp/venv/bin"
ExecStart=/home/ubuntu/aws-devops-webapp/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app

# Restart policy for high availability
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
